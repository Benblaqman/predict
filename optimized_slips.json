#!/usr/bin/env python3


"""
Generate optimized betting slips.
"""


import json
import random
from pathlib import Path
from datetime import datetime,timezone



INPUT = Path(
    "data/probability_results.json"
)


OUTPUT = Path(
    "data/optimized_slips.json"
)



TOTAL_SLIPS=10
MATCHES_PER_SLIP=5



def optimize_slips():


    with open(
        INPUT,
        encoding="utf-8"
    ) as f:

        matches=json.load(f)["results"]



    matches.sort(
        key=lambda x:
        x["confidence"],
        reverse=True
    )



    slips=[]



    for number in range(
        TOTAL_SLIPS
    ):


        selected=random.sample(

            matches,

            min(
                MATCHES_PER_SLIP,
                len(matches)
            )

        )


        odds=1

        confidence=0



        for item in selected:

            odds *= item["odds"]

            confidence += item["confidence"]



        confidence /= len(selected)



        slips.append({

            "slip":
                number+1,


            "risk":
                selected[0]["risk"],


            "matches":
                selected,


            "summary":{

                "average_confidence":
                    round(
                        confidence,
                        2
                    ),


                "combined_odds":
                    round(
                        odds,
                        2
                    )

            }

        })



    with open(
        OUTPUT,
        "w",
        encoding="utf-8"
    ) as f:


        json.dump({

            "generated":
                datetime.now(
                    timezone.utc
                ).isoformat(),


            "total_slips":
                len(slips),


            "slips":
                slips


        },f,indent=2)



    print(
        "Optimized slips created"
    )



if __name__=="__main__":

    optimize_slips()
